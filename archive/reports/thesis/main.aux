\newlabel{ch:findings}{{16}{46}{Summary of findings}{chapter.16}{}}
\@writefile{toc}{\contentsline {section}{\numberline {16.1}Established findings}{46}{section.16.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F1. Perception is the bottleneck on the short task.}{46}{section*.33}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F2. One VAE serves all task variants.}{46}{section*.34}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F3. The horizon decides the strategy.}{46}{section*.35}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F4. Coupling is a precondition for learning.}{46}{section*.36}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F5. Routing decides the phenotype, not representation.}{46}{section*.37}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F6. A grounded image pathway is required.}{46}{section*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F7. The working model reproduces the paper's behaviour.}{47}{section*.39}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F8. The cueing effect is memory-driven, across the whole family.}{47}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F9. The harness is a stable recipe with two failure harbors.}{47}{section*.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F10. Two stacked memories is the best detector, and the recommended network.}{47}{section*.42}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{F11. Perception is learnable without a pretrained VAE.}{47}{section*.43}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {16.2}Open questions}{47}{section.16.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{O1. \emph  {(Resolved.)} Which wiring restores cue-orienting attention?}{47}{section*.44}\protected@file@percent }
