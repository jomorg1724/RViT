{
  "run": {
    "seed": 0,
    "n_iterations": 200000,
    "episodes_per_iter": 8,
    "log_every": 10,
    "checkpoint_dir": "checkpoints",
    "resume_from_checkpoint": true
  },
  "environment": {
    "theta_start": 65.0,
    "noise_multiplier": 10.0,
    "min_change_time": 11,
    "max_change_time": 25
  },
  "model": {
    "in_channels": 3,
    "image_h": 50,
    "image_w": 50,
    "feature_channels": 64,
    "memory_channels": 32,
    "n_actions": 2,
    "inner_K": 2,
    "inner_eps": 0.1,
    "actor_hidden": 128,
    "critic_hidden": 128,
    "decision_channels": 8,
    "decision_coarse_grid": 2,
    "init_action_logit_bias": [0.0, -4.0],
    "pc_pixel_coef": 1.0,
    "pc_feature_coef": 0.1,
    "pc_autoenc_coef": 1.0
  },
  "training": {
    "lr": 0.0003,
    "n_epochs": 4,
    "clip_range": 0.2,
    "value_coef": 0.5,
    "entropy_coef": 0.005,
    "pc_coef": 1.0,
    "slow_coef": 0.0,
    "grad_clip": 0.5,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "bptt_truncation": 16,
    "inner_K_warmup_iters": 0,
    "pc_pretrain_iters": 20,
    "save_interval_iterations": 500
  }
}
