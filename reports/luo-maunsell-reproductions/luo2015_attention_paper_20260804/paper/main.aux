\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The seven-frame uncued task.} A complete unchanged-first-test trial ending in a correct rejection at the guaranteed changed second test. Both samples appear at $t_0$--$t_1$; the delay $t_2$ and gap $t_5$ are blank; one location is tested at $t_3$--$t_4$ and again at $t_6$. No cue appears at any frame.\relax }}{2}{figure.caption.1}\protected@file@percent }
