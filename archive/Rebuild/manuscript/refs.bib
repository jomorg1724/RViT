% for the power-mean conservation family (§extensions-A3). The classic
% reference for the power-mean monotonicity that underwrites the
% conservation-family band; no research_db/papers/ stub yet (the same
% math-methods gap flagged by rb-008 for Slepian 1962 and Tong 1990 —
% out of rebuilder scope per the reviewer's CR-035/CR-037 backlog).
@book{HLP1934,
  author    = {Hardy, G. H. and Littlewood, J. E. and P{\'o}lya, G.},
  title     = {Inequalities},
  publisher = {Cambridge University Press},
  address   = {Cambridge, UK},
  year      = {1934},
  note      = {2nd ed.\ 1952; reprinted 1988. Power-mean
               monotonicity at §2.9 ($M_p(\mathbf{x})$ is non-decreasing
               in $p$ for positive $\mathbf{x}$).}
}

% Cited by Rebuild/manuscript/sections/appendix.tex (rb-018, RB-013)
% for the §appendix-C5 Sterbenz-lemma bit-exact recovery argument
% (Proposition prop:c5-sterbenz). Math-methods reference; same
% scope-gap as Slepian 1962 / Tong 1990 / Hardy-Littlewood-Polya 1934
% (no research_db/papers/ stub, cited by full bibliographic reference;
% out of rebuilder scope per the math-methods gap flagged by rb-008
% and the reviewer's CR-035/CR-037 backlog).
@book{Sterbenz1974,
  author    = {Sterbenz, Pat H.},
  title     = {Floating-Point Computation},
  publisher = {Prentice-Hall},
  address   = {Englewood Cliffs, NJ},
  year      = {1974},
  note      = {Theorem 4.3.1 (subtraction without round-off, the
               ``Sterbenz lemma''): if $a/2 \le x \le 2a$ then
               $\mathrm{fl}(x - a) = x - a$ exactly under any IEEE-754
               round-to-nearest mode.}
}

% Cited by Rebuild/manuscript/sections/appendix.tex (rb-018, RB-013)
% for the §appendix-C5 IEEE-754 background. The standard secondary
% reference for the Sterbenz lemma in the CS literature; same
% math-methods scope as Sterbenz 1974 above.
@article{Goldberg1991,
  author  = {Goldberg, David},
  title   = {What Every Computer Scientist Should Know About
             Floating-Point Arithmetic},
  journal = {ACM Computing Surveys},
  volume  = {23},
  number  = {1},
  pages   = {5--48},
  year    = {1991},
  doi     = {10.1145/103162.103163},
  note    = {Theorem 11 (the Sterbenz lemma, re-stated in IEEE-754
             notation): exact subtraction holds inside the band
             $[a/2, 2a]$.}
}

