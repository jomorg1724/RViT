\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Decorrelation sensitivity of the peak VDA benefit at $(N, d'_{\max }, f_0, h, V) = (4, 2, 0.5, \sqrt  {\tmspace  +\thickmuskip {.2777em}\cdot \tmspace  +\thickmuskip {.2777em}}, 0.5)$, additive conservation. Raising $\rho $ from $0$ to $0.2$ suppresses peak $\mathrm  {VDA}^\star $ for $v\le 8$ and amplifies it at $v= 10$, while the peak location $r^\star $ drifts upward (most visibly at low $v$). The sign of $\partial \mathrm  {VDA}^\star / \partial \rho $ thus depends on the cued value.}}{13}{table.5}\protected@file@percent }
\newlabel{tab:rho-sensitivity}{{5}{13}{Decorrelation sensitivity of the peak VDA benefit at $(\Nloc , \dprimemax , f_0, h, \valid ) = (4, 2, 0.5, \sqrt {\;\cdot \;}, 0.5)$, additive conservation. Raising $\corr $ from $0$ to $0.2$ suppresses peak $\VDA ^\star $ for $\val \le 8$ and amplifies it at $\val = 10$, while the peak location $r^\star $ drifts upward (most visibly at low $\val $). The sign of $\partial \VDA ^\star / \partial \corr $ thus depends on the cued value}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-panel distribution of $\mathrm  {VDA}$ over the $31 \times 19 = 589$ $(V, v)$ cells, at the headline configuration $(N, d'_{\max }, f_0, h) = (4,\,2,\,0.5,\,\sqrt  {}\,)$, variant~A. The median $\mathrm  {VDA}\le 0.007$ in every panel: most of the design plane carries near-zero benefit. The $\mathrm  {frac}\!\ge \!0.05$ column collapses from $\approx 29\%$ at $r= 0.3$ to $\le 2\%$ at $r= 3$, quantifying the flattening of the contour band along the $r$-axis.}}{13}{table.6}\protected@file@percent }
\newlabel{tab:graded-marginals}{{6}{13}{Per-panel distribution of $\VDA $ over the $31 \times 19 = 589$ $(\valid , \val )$ cells, at the headline configuration $(\Nloc , \dprimemax , f_0, h) = (4,\,2,\,0.5,\,\sqrt {}\,)$, variant~A. The median $\VDA \le 0.007$ in every panel: most of the design plane carries near-zero benefit. The $\mathrm {frac}\!\ge \!0.05$ column collapses from $\approx 29\%$ at $\Rsens = 0.3$ to $\le 2\%$ at $\Rsens = 3$, quantifying the flattening of the contour band along the $\Rsens $-axis}{table.6}{}}
