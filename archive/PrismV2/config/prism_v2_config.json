    "pc_V2_feat_autoenc_coef": 0.5
  },
  "training": {
    "lr": 0.0003,
    "n_epochs": 4,
    "clip_range": 0.2,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "pc_coef": 1.0,
    "slow_coef": 0.0,
    "grad_clip": 0.5,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "bptt_truncation": 32,
    "value_huber_kappa": 1.0,
    "inner_K_warmup_iters": 0,
    "pc_pretrain_iters": 0,
    "save_interval_iterations": 500
