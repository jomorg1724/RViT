{
  "_comment": "Affine feedback + two xLSTMs + conv 4x4 front-end + sequential JEPA auxiliary. No VAE, no pretraining; train RL and JEPA simultaneously.",
  "run": {
    "init_mode": "fresh",
    "checkpoint_path": "",
    "checkpoint_dir": "/Users/jonathanmorgan/rvit_plus_checkpoints/affine2lstm_jepa",
    "seed": 0,
    "device": "",
    "log_every": 5,
    "save_every": 200
  },
  "environment": {
    "_note": "Paper 7-step task; change fixed at t=5.",
    "T": 7,
    "min_change_time": 5,
    "max_change_time": 5,
    "noise_multiplier": 5.0
  },
  "model": {
    "_note": "Conv front-end emits 4x4 tokens with d_model=140. Affine feedback uses H1; H2 drives RL heads and JEPA.",
    "jepa_latent_dim": 256,
    "rl": { "n_actions": 2, "n_quantiles": 5, "init_action_bias": [0.0, -1.5] }
  },
  "ppo": {
    "_note": "Same RL harness as the paper runs, plus JEPA on valid adjacent H2 pairs.",
    "iters": 18750,
    "episodes_per_iter": 8,
    "lr": 0.0003,
    "n_epochs": 4,
    "grad_clip": 0.5,
    "grad_value_clip": 1000000.0,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "qr_kappa": 1.0,
    "gamma": 0.95,
    "mpo_temperature": 0.1,
    "bc_alpha": 0.1,
    "target_update_period": 0,
    "ema_decay": 0.995,
    "burn_in_iters": 20,
    "buffer_capacity": 1000,
    "per_n_replay": 4,
    "per_alpha": 0.6,
    "per_beta_start": 0.4,
    "per_beta_end": 1.0,
    "per_priority_clip": 50.0,
    "jepa_coef": 0.25,
    "jepa_ema_decay": 0.995
  }
}
