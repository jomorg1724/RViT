\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {M2A: shared recurrent agent.} \textcolor {VdaPurple}{\textbf  {Source-derived model specification.}} RGB frames become spatial patch tokens, undergo feedback routing, update a shared spatial xLSTM, and feed actor, quantile-regression critic, and an optional training-only JEPA readout. Token count follows task geometry; widths and JEPA enablement are run-resolved and are not established for historical cache entries.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:m2a}{{3}{10}{\textbf {M2A: shared recurrent agent.} \eclass {Source-derived model specification.} RGB frames become spatial patch tokens, undergo feedback routing, update a shared spatial xLSTM, and feed actor, quantile-regression critic, and an optional training-only JEPA readout. Token count follows task geometry; widths and JEPA enablement are run-resolved and are not established for historical cache entries}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {M2B: element-wise affine feedback.} \textcolor {VdaPurple}{\textbf  {Source-derived model specification.}} Previous memory generates scale $\gamma $ and shift $\beta $, producing $X'=\gamma \odot X+\beta $ before self-attention. Identity initialization starts with $\gamma =1$ and $\beta =0$. The diagram does not show learned values.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:m2b}{{4}{11}{\textbf {M2B: element-wise affine feedback.} \eclass {Source-derived model specification.} Previous memory generates scale $\gamma $ and shift $\beta $, producing $X'=\gamma \odot X+\beta $ before self-attention. Identity initialization starts with $\gamma =1$ and $\beta =0$. The diagram does not show learned values}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {M2C: spatial recurrent memory and readouts.} \textcolor {VdaPurple}{\textbf  {Source-derived model specification.}} Routed tokens and prior recurrent states enter the spatial xLSTM; the new hidden state both supplies the next routing step and, after flattening, feeds actor and critic. Arrow direction makes the temporal feedback boundary explicit.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:m2c}{{5}{12}{\textbf {M2C: spatial recurrent memory and readouts.} \eclass {Source-derived model specification.} Routed tokens and prior recurrent states enter the spatial xLSTM; the new hidden state both supplies the next routing step and, after flattening, feeds actor and critic. Arrow direction makes the temporal feedback boundary explicit}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {M2D: cross-attention comparator.} \textcolor {VdaPurple}{\textbf  {Source-derived model specification.}} Current visual tokens provide queries while visual and recurrent-memory streams jointly provide keys and values. The same recurrent memory and policy heads follow; only the routing operator changes.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:m2d}{{6}{13}{\textbf {M2D: cross-attention comparator.} \eclass {Source-derived model specification.} Current visual tokens provide queries while visual and recurrent-memory streams jointly provide keys and values. The same recurrent memory and policy heads follow; only the routing operator changes}{figure.6}{}}
