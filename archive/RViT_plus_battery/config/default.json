{
  "_comment": "Shared defaults for the FiLM battery. Per-task differences come from --task (env + grid). Checkpoints live OUTSIDE the Drive-synced repo.",
  "run": {
    "init_mode": "resume",
    "checkpoint_path": "",
    "checkpoint_dir": "",
    "seed": 0,
    "device": "",
    "log_every": 5,
    "save_every": 200
  },
  "environment": { "_note": "paper 7-step task; change fixed at t=5", "T": 7, "min_change_time": 5, "max_change_time": 5, "noise_multiplier": 5.0 },
  "model": {
    "front_end": "pixel", "d_model": 128, "d_mem": 128,
    "tx_heads": 1, "tx_layers": 1, "n_lstm": 2,
    "conv_channels": 64, "n_conv_layers": 2, "conv_kernel": 3,
    "rl": { "n_actions": 2, "n_quantiles": 51, "init_action_bias": [0.0, -1.5] }
  },
  "ppo": {
    "iters": 15000, "episodes_per_iter": 8, "seq_len": 29,
    "lr": 0.0003, "n_epochs": 4, "grad_clip": 0.5, "value_coef": 0.5,
    "entropy_coef": 0.01, "qr_kappa": 1.0, "gamma": 0.99,
    "mpo_temperature": 0.1, "bc_alpha": 0.1, "target_update_period": 100,
    "burn_in_iters": 20, "buffer_capacity": 1000, "per_n_replay": 4,
    "per_alpha": 0.6, "per_beta_start": 0.4, "per_beta_end": 1.0, "per_priority_clip": 50.0
  }
}
