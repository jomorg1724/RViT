\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Closed-form escape threshold $r^{\dagger }(v) = K_u(v) / [(N- 1)\,K_c(v)]$ from \eqref  {eq:r-dagger}--\eqref  {eq:K-u} at $(N, d'_{\max }, f_0, h, V) = (4,\,2,\,0.5,\,\sqrt  {\tmspace  +\thickmuskip {.2777em}\cdot \tmspace  +\thickmuskip {.2777em}},\,0.5)$, additive conservation. The $v= 1$ row is the symmetric reference $r^{\dagger }(1) \approx 0.343$; the threshold falls monotonically as the cued value grows.}}{11}{table.3}\protected@file@percent }
\newlabel{tab:r-dagger-family}{{3}{11}{Closed-form escape threshold $\rdagger (\val ) = K_u(\val ) / [(\Nloc - 1)\,K_c(\val )]$ from \eqref {eq:r-dagger}--\eqref {eq:K-u} at $(\Nloc , \dprimemax , f_0, h, \valid ) = (4,\,2,\,0.5,\,\sqrt {\;\cdot \;},\,0.5)$, additive conservation. The $\val = 1$ row is the symmetric reference $\rdagger (1) \approx 0.343$; the threshold falls monotonically as the cued value grows}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The closed-form escape threshold $r^{\dagger }(v)$ at $(N, d'_{\max }, f_0, h, V) = (4,\,2,\,0.5,\,\sqrt  {\tmspace  +\thickmuskip {.2777em}\cdot \tmspace  +\thickmuskip {.2777em}},\,0.5)$, additive conservation. The continuous curve is computed from \eqref  {eq:r-dagger}--\eqref  {eq:K-u} on a dense $v$-grid, with the family points $v\in \{2,3,5,8,10\}$ marked. The horizontal reference $r^{\dagger }(1) \approx 0.343$ is the symmetric upper anchor of the family. The threshold marks the benefit/cost ratio at which the optimal observer first leaves uniform attention.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:r-dagger-vs-v}{{4}{11}{The closed-form escape threshold $\rdagger (\val )$ at $(\Nloc , \dprimemax , f_0, h, \valid ) = (4,\,2,\,0.5,\,\sqrt {\;\cdot \;},\,0.5)$, additive conservation. The continuous curve is computed from \eqref {eq:r-dagger}--\eqref {eq:K-u} on a dense $\val $-grid, with the family points $\val \in \{2,3,5,8,10\}$ marked. The horizontal reference $\rdagger (1) \approx 0.343$ is the symmetric upper anchor of the family. The threshold marks the benefit/cost ratio at which the optimal observer first leaves uniform attention}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Decorrelation sensitivity.}{11}{section*.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Empirical peak $r^\star = \arg \max _{r} \mathrm  {VDA}(r)$ against the closed-form escape threshold $r^{\dagger }(v)$ at $(N, d'_{\max }, f_0, h, V) = (4,\,2,\,0.5,\,\sqrt  {\tmspace  +\thickmuskip {.2777em}\cdot \tmspace  +\thickmuskip {.2777em}},\,0.5)$, $\rho = 0$. The peak lies above $r^{\dagger }(v)$ for every $v$ and clusters near the symmetric anchor $r^{\dagger }(1) \approx 0.343$, consistent with the prediction that $\mathrm  {VDA}$ is supported on the interval $(r^{\dagger }(v),\, r^{\dagger }(1))$. Peak located on an $84$-point log-grid in $r$.}}{12}{table.4}\protected@file@percent }
\newlabel{tab:peak-vs-threshold}{{4}{12}{Empirical peak $r^\star = \arg \max _{\Rsens } \VDA (\Rsens )$ against the closed-form escape threshold $\rdagger (\val )$ at $(\Nloc , \dprimemax , f_0, h, \valid ) = (4,\,2,\,0.5,\,\sqrt {\;\cdot \;},\,0.5)$, $\corr = 0$. The peak lies above $\rdagger (\val )$ for every $\val $ and clusters near the symmetric anchor $\rdagger (1) \approx 0.343$, consistent with the prediction that $\VDA $ is supported on the interval $(\rdagger (\val ),\, \rdagger (1))$. Peak located on an $84$-point log-grid in $\Rsens $}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Non-monotonicity of $\mathrm  {VDA}(r)$ in the benefit/cost ratio across a $v$-family at $(N, d'_{\max }, f_0, h, V) = (4, 2, 0.5, \sqrt  {\tmspace  +\thickmuskip {.2777em}\cdot \tmspace  +\thickmuskip {.2777em}}, 0.5)$, additive conservation. \textbf  {Left:} $\rho = 0$. Each curve rises from zero, peaks in the interior, and decays; the closed-form escape threshold $r^{\dagger }(v)$ from \eqref  {eq:r-dagger} is overlaid as a vertical dashed line per $v$, and the empirical peak (white-filled dot) lies above $r^{\dagger }(v)$ for every $v$ (Table~\ref {tab:peak-vs-threshold}). \textbf  {Right:} the same family at $\rho = 0.2$; correlated noise suppresses the peak at low $v$ but amplifies it at $v= 10$, so the sign of $\partial \mathrm  {VDA}^\star / \partial \rho $ depends on the cued value (Table~\ref {tab:rho-sensitivity}).}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:vda-curves-vfamily}{{5}{12}{Non-monotonicity of $\VDA (\Rsens )$ in the benefit/cost ratio across a $\val $-family at $(\Nloc , \dprimemax , f_0, h, \valid ) = (4, 2, 0.5, \sqrt {\;\cdot \;}, 0.5)$, additive conservation. \textbf {Left:} $\corr = 0$. Each curve rises from zero, peaks in the interior, and decays; the closed-form escape threshold $\rdagger (\val )$ from \eqref {eq:r-dagger} is overlaid as a vertical dashed line per $\val $, and the empirical peak (white-filled dot) lies above $\rdagger (\val )$ for every $\val $ (Table~\ref {tab:peak-vs-threshold}). \textbf {Right:} the same family at $\corr = 0.2$; correlated noise suppresses the peak at low $\val $ but amplifies it at $\val = 10$, so the sign of $\partial \VDA ^\star / \partial \corr $ depends on the cued value (Table~\ref {tab:rho-sensitivity})}{figure.5}{}}
