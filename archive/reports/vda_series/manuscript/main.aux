\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Historical VDA4 task specification.} \textcolor {VdaPurple}{\textbf  {Deterministic task-derived schematic.}} The figure documents the seven-frame sequence, $2\times 2$ geometry, four active items, four model tokens, and archived cue-including validity. At displayed validity 0.25, the realized cue probability is 0.438. It contains no learned-model measurement and establishes neither performance nor mechanism.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:m1-historical}{{1}{7}{\textbf {Historical VDA4 task specification.} \eclass {Deterministic task-derived schematic.} The figure documents the seven-frame sequence, $2\times 2$ geometry, four active items, four model tokens, and archived cue-including validity. At displayed validity 0.25, the realized cue probability is 0.438. It contains no learned-model measurement and establishes neither performance nor mechanism}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Controlled fixed-grid VDA4 task specification.} \textcolor {VdaPurple}{\textbf  {Deterministic task-derived schematic.}} Across the controlled fixed-grid series, geometry is held at $4\times 4$; unlike historical VDA4, this four-active-item task therefore has sixteen model tokens. Invalid targets exclude the cue, making displayed and realized validity equal. This is a protocol specification, not evidence that an accepted checkpoint exists.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:m1-controlled}{{2}{8}{\textbf {Controlled fixed-grid VDA4 task specification.} \eclass {Deterministic task-derived schematic.} Across the controlled fixed-grid series, geometry is held at $4\times 4$; unlike historical VDA4, this four-active-item task therefore has sixteen model tokens. Invalid targets exclude the cue, making displayed and realized validity equal. This is a protocol specification, not evidence that an accepted checkpoint exists}{figure.2}{}}
