\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Achieved cued-location attention mass under the additive bias sweep, cross-attention (left) and affine (right).} Both routing families' achieved attention rises smoothly with nominal bias; only affine's \emph  {invalid-trial} sensitivity falls monotonically as that mass grows, because the boosted location is the wrong one on invalid trials.\relax }}{21}{figure.caption.24}\protected@file@percent }
\newlabel{fig:vda16-clamp}{{21}{21}{\textbf {Achieved cued-location attention mass under the additive bias sweep, cross-attention (left) and affine (right).} Both routing families' achieved attention rises smoothly with nominal bias; only affine's \emph {invalid-trial} sensitivity falls monotonically as that mass grows, because the boosted location is the wrong one on invalid trials.\relax }{figure.caption.24}{}}
