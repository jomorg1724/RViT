\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Behaviour on controlled fixed-magnitude slices.} Hit rate, signal-detection decomposition, and mean hit frame as a function of first-test orientation change. Sensitivity peaks at $18^\circ $ --- the probe used for every attention figure --- and both $d'$ and $c$ degrade at the largest changes.\relax }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:behaviour}{{2}{3}{\textbf {Behaviour on controlled fixed-magnitude slices.} Hit rate, signal-detection decomposition, and mean hit frame as a function of first-test orientation change. Sensitivity peaks at $18^\circ $ --- the probe used for every attention figure --- and both $d'$ and $c$ degrade at the largest changes.\relax }{figure.caption.2}{}}
