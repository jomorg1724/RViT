{
  "_comment": "DMD-feature transformer. No conv, no VAE: four quadrant time-series -> top 20 DMD eigenvalues per patch -> CLS TransformerEncoder -> actor/critic.",
  "run": {
    "init_mode": "fresh",
    "checkpoint_path": "",
    "checkpoint_dir": "/Users/jonathanmorgan/rvit_plus_checkpoints/dmd_transformer",
    "seed": 0,
    "device": "",
    "log_every": 5,
    "save_every": 200
  },
  "environment": {
    "T": 7,
    "min_change_time": 5,
    "max_change_time": 5,
    "noise_multiplier": 5.0
  },
  "model": {
    "_note": "DMD gives 40 features per patch: real/imag for top 20 eigenvalues. Missing modes early in the episode are zero-padded. Actor/critic read CLS.",
    "d_model": 256,
    "n_heads": 1,
    "n_layers": 2,
    "rl": { "n_actions": 2, "n_quantiles": 5, "init_action_bias": [0.0, -1.5] }
  },
  "ppo": {
    "iters": 18750,
    "episodes_per_iter": 8,
    "lr": 0.0003,
    "n_epochs": 4,
    "grad_clip": 0.5,
    "grad_value_clip": 1000000.0,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "qr_kappa": 1.0,
    "gamma": 0.95,
    "mpo_temperature": 0.1,
    "bc_alpha": 0.1,
    "target_update_period": 0,
    "ema_decay": 0.995,
    "burn_in_iters": 20,
    "buffer_capacity": 1000,
    "per_n_replay": 4,
    "per_alpha": 0.6,
    "per_beta_start": 0.4,
    "per_beta_end": 1.0,
    "per_priority_clip": 50.0
  }
}
