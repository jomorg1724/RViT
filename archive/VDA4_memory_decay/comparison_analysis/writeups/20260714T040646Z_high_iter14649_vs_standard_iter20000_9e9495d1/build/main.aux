\@writefile{toc}{\contentsline {section}{\numberline {2}Frozen checkpoints and matched protocol}{1}{section.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Frozen model identities. Both checkpoints validate as VDA4, xLSTM, \texttt  {crossattn1}, $d_{mem}=128$, convolutional front end, and $2\times 2$ geometry.}}{1}{table.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Results}{2}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Primary activity result and secondary descriptors}{2}{subsection.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired high-decay minus standard estimates. Bootstrap intervals are over matched evaluation trials, not training seeds.}}{2}{table.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Dynamic and spatial attention descriptors.} Time courses compare the standard and high-decay checkpoints under valid and forced-invalid changes, show image-versus-memory allocation, and separate trials with and without a qualifying change response. Every trace derives from raw $4\times 8$ softmax maps before summary.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:metrics}{{1}{3}{\textbf {Dynamic and spatial attention descriptors.} Time courses compare the standard and high-decay checkpoints under valid and forced-invalid changes, show image-versus-memory allocation, and separate trials with and without a qualifying change response. Every trace derives from raw $4\times 8$ softmax maps before summary}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Behavior at valid and forced-invalid locations}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Behavioral comparison.} Qualifying change-response probability across change magnitude for valid and deliberately forced-invalid locations at four displayed cue proportions. Difference panels show high decay minus standard. The target location is fixed by analysis in every curve; displayed validity changes the cue appearance but does not sample target location.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:psychometric}{{2}{4}{\textbf {Behavioral comparison.} Qualifying change-response probability across change magnitude for valid and deliberately forced-invalid locations at four displayed cue proportions. Difference panels show high decay minus standard. The target location is fixed by analysis in every curve; displayed validity changes the cue appearance but does not sample target location}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Where the attention moves}{5}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Query-averaged event maps.} Standard and high-decay attention under matched valid and forced-invalid videos. Image keys and recurrent-memory keys are displayed separately across all seven frames. This is the overview; the following plates preserve the full query axis.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:average-maps}{{3}{6}{\textbf {Query-averaged event maps.} Standard and high-decay attention under matched valid and forced-invalid videos. Image keys and recurrent-memory keys are displayed separately across all seven frames. This is the overview; the following plates preserve the full query axis}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Valid condition, image keys.} Each tile preserves the four query rows and four image-key columns. The cue and $15^\circ $ change are both at S1; paired models receive identical videos.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:valid-image}{{4}{7}{\textbf {Valid condition, image keys.} Each tile preserves the four query rows and four image-key columns. The cue and $15^\circ $ change are both at S1; paired models receive identical videos}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Valid condition, recurrent-memory keys.} Full query-to-memory routing for the same valid trials. Comparison with Figure~\ref {fig:valid-image} shows whether a frame-to-frame shift is within a source block or between image and memory.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:valid-memory}{{5}{8}{\textbf {Valid condition, recurrent-memory keys.} Full query-to-memory routing for the same valid trials. Comparison with Figure~\ref {fig:valid-image} shows whether a frame-to-frame shift is within a source block or between image and memory}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Forced-invalid condition, image keys.} The cue remains at S1 while the change is forced to S4. Videos are matched through frame 4, so valid--invalid divergence before the event would indicate analysis or stochastic mismatch.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:invalid-image}{{6}{9}{\textbf {Forced-invalid condition, image keys.} The cue remains at S1 while the change is forced to S4. Videos are matched through frame 4, so valid--invalid divergence before the event would indicate analysis or stochastic mismatch}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Forced-invalid condition, recurrent-memory keys.} Query-preserving memory routing after a change outside the cued location. This plate is the direct spatial test requested for invalid attention.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:invalid-memory}{{7}{10}{\textbf {Forced-invalid condition, recurrent-memory keys.} Query-preserving memory routing after a change outside the cued location. This plate is the direct spatial test requested for invalid attention}{figure.7}{}}
