\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Historical VDA4 (left) and controlled fixed-grid VDA4 (right). The visible task is similar, but the grid and cue-validity semantics differ. These are deterministic specifications, not behavioral evidence.}}{5}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ln-task}{{1}{5}{Historical VDA4 (left) and controlled fixed-grid VDA4 (right). The visible task is similar, but the grid and cue-validity semantics differ. These are deterministic specifications, not behavioral evidence}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Shared recurrent pipeline (top), affine feedback (bottom left), and cross-attention feedback (bottom right). In the affine model, $H_{t-1}$ modulates the current-image tokens before an $N\times N$ self-attention operation; there is no separate hidden-state-key map. In the cross-attention model, $N$ current-image queries attend jointly to $N$ keys projected from $X_t$ and $N$ keys projected from $H_{t-1}$ under one softmax.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:ln-architecture}{{2}{5}{Shared recurrent pipeline (top), affine feedback (bottom left), and cross-attention feedback (bottom right). In the affine model, $H_{t-1}$ modulates the current-image tokens before an $N\times N$ self-attention operation; there is no separate hidden-state-key map. In the cross-attention model, $N$ current-image queries attend jointly to $N$ keys projected from $X_t$ and $N$ keys projected from $H_{t-1}$ under one softmax}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Architecture-grounded attention vocabulary. Routing family, key source, query reduction, spatial aggregation, and event frame are separate labels and must all be stated.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:ln-attention-terms}{{4}{6}{Architecture-grounded attention vocabulary. Routing family, key source, query reduction, spatial aggregation, and event frame are separate labels and must all be stated}{table.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Entry LN-02: Cued behavior and sensitivity}{6}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cueing-effect magnitude versus active-item set size. The cross-attention sequence is motivating evidence; the affine sequence prevents a universal capacity-law claim.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:ln-setsize-summary}{{3}{7}{Cueing-effect magnitude versus active-item set size. The cross-attention sequence is motivating evidence; the affine sequence prevents a universal capacity-law claim}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Unmanipulated VDA16 sensitivity and criterion. Solid lines are valid trials; dashed lines are forced-invalid. This is the appropriate behavioral bridge to an attention mechanism claim.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ln-baseline-sdt}{{4}{7}{Unmanipulated VDA16 sensitivity and criterion. Solid lines are valid trials; dashed lines are forced-invalid. This is the appropriate behavioral bridge to an attention mechanism claim}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Entry LN-03: Current-image-key and previous-hidden-state-key routing over time}{8}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces VDA4 cross-attention no-change routing. Left: query-averaged incoming mass $p^X$ to keys projected from current-image tokens $X_t$. Right: query-averaged incoming mass $p^H$ to keys projected from the previous recurrent hidden output $H_{t-1}$. The embedded legacy headings ``image keys'' and ``recurrent-memory keys'' refer to these two blocks. Neither block is renormalized within source; both preserve their absolute share under the same joint $2N$-key softmax and use one common raw scale. No affine checkpoint appears. These maps describe allocation, not representation quality or causal use.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ln-vda4-sources}{{5}{8}{VDA4 cross-attention no-change routing. Left: query-averaged incoming mass $p^X$ to keys projected from current-image tokens $X_t$. Right: query-averaged incoming mass $p^H$ to keys projected from the previous recurrent hidden output $H_{t-1}$. The embedded legacy headings ``image keys'' and ``recurrent-memory keys'' refer to these two blocks. Neither block is renormalized within source; both preserve their absolute share under the same joint $2N$-key softmax and use one common raw scale. No affine checkpoint appears. These maps describe allocation, not representation quality or causal use}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces VDA16 cross-attention no-change routing. Left is $p^X$ to current-image keys; right is $p^H$ to previous-hidden-state keys. The two blocks preserve absolute mass under one joint $2N$-key softmax and use one common raw scale; they are never added. The embedded panel headings are legacy aliases. No affine checkpoint appears.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ln-vda16-sources}{{6}{9}{VDA16 cross-attention no-change routing. Left is $p^X$ to current-image keys; right is $p^H$ to previous-hidden-state keys. The two blocks preserve absolute mass under one joint $2N$-key softmax and use one common raw scale; they are never added. The embedded panel headings are legacy aliases. No affine checkpoint appears}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces VDA16 \texttt  {crossattn1} held-out paired behavior only. The cue is fixed at S1; the physical change occurs either at valid S1 or forced-invalid S16 over 300 matched trials per magnitude. Panel A reports qualifying response probability. Panel B reports the model's discrete response frame conditional on responding; it is not human reaction time. Bands are finite evaluation-trial intervals from one checkpoint, not training-seed uncertainty or paired-difference intervals. No attention sources are summed or displayed, and this change-present bank cannot by itself estimate $d'$ or criterion.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ln-vda16-paired-behavior}{{7}{9}{VDA16 \texttt {crossattn1} held-out paired behavior only. The cue is fixed at S1; the physical change occurs either at valid S1 or forced-invalid S16 over 300 matched trials per magnitude. Panel A reports qualifying response probability. Panel B reports the model's discrete response frame conditional on responding; it is not human reaction time. Bands are finite evaluation-trial intervals from one checkpoint, not training-seed uncertainty or paired-difference intervals. No attention sources are summed or displayed, and this change-present bank cannot by itself estimate $d'$ or criterion}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Entry LN-04: Spatially specific causal rescue}{10}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The central VDA result: only a bias targeted at the true change location produces the predicted bidirectional rescue. Panels jointly report response, $d'$, criterion, and achieved attention.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ln-central-causal}{{8}{10}{The central VDA result: only a bias targeted at the true change location produces the predicted bidirectional rescue. Panels jointly report response, $d'$, criterion, and achieved attention}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Achieved attention at the true change location across the trial. Direct true-location targeting raises its mass; forcing either control location lowers it competitively.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:ln-central-trajectory}{{9}{11}{Achieved attention at the true change location across the trial. Direct true-location targeting raises its mass; forcing either control location lowers it competitively}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces VDA4 scale-down. True-location targeting remains the largest and most orderly effect, but control behavior differs from VDA16.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:ln-vda4-causal}{{10}{11}{VDA4 scale-down. True-location targeting remains the largest and most orderly effect, but control behavior differs from VDA16}{figure.caption.15}{}}
