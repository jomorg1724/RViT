\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Closed-form VDA-escape threshold $r^{\dagger }(v)$ at the headline cell $(N, d'_{\max }, f_0, h, V) = (4,\,2,\,0.5,\,\sqrt  {},\,0.5)$, variant~A. Continuous trace computed from \eqref  {eq:r-dagger}--\eqref  {eq:K-u} on a dense $v$-grid; family points $v\in \{2,3,5,8,10\}$ marked. The horizontal reference $r^{\dagger }(1) \approx 0.343$ is the symmetric upper anchor of the family. Reproduced from \texttt  {Rebuild/sims/C2--vda-vs-r-vfamily/output/figures/r\_dagger\_vs\_v.png}.}}{17}{figure.10}\protected@file@percent }
\newlabel{fig:r-dagger-vs-v}{{10}{17}{Closed-form VDA-escape threshold $\rdagger (\val )$ at the headline cell $(\Nloc , \dprimemax , f_0, h, \valid ) = (4,\,2,\,0.5,\,\sqrt {},\,0.5)$, variant~A. Continuous trace computed from \eqref {eq:r-dagger}--\eqref {eq:K-u} on a dense $\val $-grid; family points $\val \in \{2,3,5,8,10\}$ marked. The horizontal reference $\rdagger (1) \approx 0.343$ is the symmetric upper anchor of the family. Reproduced from \texttt {Rebuild/sims/C2--vda-vs-r-vfamily/output/figures/r\_dagger\_vs\_v.png}}{figure.10}{}}
\@writefile{toc}{\contentsline {paragraph}{A1 sensitivity: $v$-dependent sign-flip of $\partial \mathrm  {VDA}^\star / \partial \rho $.}{17}{section*.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Empirical peak $r^\star = \arg \max _{r} \mathrm  {VDA}(r)$ vs.\ closed-form escape threshold $r^{\dagger }(v)$ at the headline cell, $\rho = 0$. The peak $r^\star $ lies above $r^{\dagger }(v)$ for every $v$ and clusters near $r^{\dagger }(v{=}1) \approx 0.343$, consistent with the prediction that $\mathrm  {VDA}$ is supported on the interior interval $(r^{\dagger }(v),\,r^{\dagger }(1))$. Numerical resolution: peak $r^\star $ on an $84$-point log-grid; recovery against the rb-002 reference at $r \in \{0.398, 1.000, 3.162\}$ at $\max |\Delta \mathrm  {VDA}| = 4.87 \times 10^{-6}$.}}{18}{table.7}\protected@file@percent }
\newlabel{tab:peak-vs-threshold}{{7}{18}{Empirical peak $r^\star = \arg \max _{\Rsens } \VDA (\Rsens )$ vs.\ closed-form escape threshold $\rdagger (\val )$ at the headline cell, $\corr = 0$. The peak $r^\star $ lies above $\rdagger (\val )$ for every $\val $ and clusters near $\rdagger (\val {=}1) \approx 0.343$, consistent with the prediction that $\VDA $ is supported on the interior interval $(\rdagger (\val ),\,\rdagger (1))$. Numerical resolution: peak $r^\star $ on an $84$-point log-grid; recovery against the rb-002 reference at $r \in \{0.398, 1.000, 3.162\}$ at $\max |\Delta \VDA | = 4.87 \times 10^{-6}$}{table.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Non-monotonicity of $\mathrm  {VDA}(r)$ in the benefit/cost ratio across a $v$-family at the headline cell $(N, d'_{\max }, f_0, h, V) = (4, 2, 0.5, \sqrt  {}, 0.5)$, variant~A. Left: $\rho = 0$ (the inherited independent model); the closed-form escape threshold $r^{\dagger }(v)$ from \eqref  {eq:r-dagger} is overlaid as a vertical dashed line for each $v$, and the empirical peak (white-filled dot) lies above $r^{\dagger }(v)$ for every $v$ in the family (cf.\ Table~\ref {tab:peak-vs-threshold}). Right: same family at $\rho = 0.2$ --- the A1 decorrelation channel suppresses the peak at low $v$ but amplifies it at $v= 10$ (cf.\ Table~\ref {tab:rho-sensitivity}); the sign of $\partial \mathrm  {VDA}^\star /\partial \rho $ depends on $v$, not just on $r$. Reproduced from \texttt  {Rebuild/sims/C2--vda-vs-r-vfamily/output/figures/vda\_curves\_vfamily.png}.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:vda-curves-vfamily}{{11}{18}{Non-monotonicity of $\VDA (\Rsens )$ in the benefit/cost ratio across a $\val $-family at the headline cell $(\Nloc , \dprimemax , f_0, h, \valid ) = (4, 2, 0.5, \sqrt {}, 0.5)$, variant~A. Left: $\corr = 0$ (the inherited independent model); the closed-form escape threshold $\rdagger (\val )$ from \eqref {eq:r-dagger} is overlaid as a vertical dashed line for each $\val $, and the empirical peak (white-filled dot) lies above $\rdagger (\val )$ for every $\val $ in the family (cf.\^^MTable~\ref {tab:peak-vs-threshold}). Right: same family at $\corr = 0.2$ --- the A1 decorrelation channel suppresses the peak at low $\val $ but amplifies it at $\val = 10$ (cf.\^^MTable~\ref {tab:rho-sensitivity}); the sign of $\partial \VDA ^\star /\partial \corr $ depends on $\val $, not just on $\Rsens $. Reproduced from \texttt {Rebuild/sims/C2--vda-vs-r-vfamily/output/figures/vda\_curves\_vfamily.png}}{figure.11}{}}
