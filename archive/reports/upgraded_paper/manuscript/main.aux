\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {(Preliminary; cued variant.)} \textbf  {The reward-structure manipulation reproduces the Luo--Maunsell sensitivity/criterion double dissociation.} Across all three change magnitudes, the \emph  {sensitivity} session (value concentrated at one location) yields a larger sensitivity gap ($\Delta d'$, left) at a \emph  {low} false-alarm rate (right), whereas the \emph  {criterion} session (global hit/correct-rejection reward) yields a smaller sensitivity gap but a \emph  {high} false-alarm rate. At the near-threshold magnitude $\Delta = 18^\circ $: $\Delta d'= 1.09$ at $\mathrm  {FA} = 0.02$ (sensitivity) versus $\Delta d'= 0.59$ at $\mathrm  {FA} = 0.18$ (criterion).}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:luo_repro}{{2}{9}{\textbf {(Preliminary; cued variant.)} \textbf {The reward-structure manipulation reproduces the Luo--Maunsell sensitivity/criterion double dissociation.} Across all three change magnitudes, the \emph {sensitivity} session (value concentrated at one location) yields a larger sensitivity gap ($\Delta \dprime $, left) at a \emph {low} false-alarm rate (right), whereas the \emph {criterion} session (global hit/correct-rejection reward) yields a smaller sensitivity gap but a \emph {high} false-alarm rate. At the near-threshold magnitude $\Delta = 18^\circ $: $\Delta \dprime = 1.09$ at $\mathrm {FA} = 0.02$ (sensitivity) versus $\Delta \dprime = 0.59$ at $\mathrm {FA} = 0.18$ (criterion)}{figure.2}{}}
