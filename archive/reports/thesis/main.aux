\newlabel{tab:jepa}{{11.1}{31}{V-JEPA self-distillation variants. Rolling correct is the late-window training rolling-correct mean unless a greedy-eval number is noted; greedy figures are held-out (paper\_jepa\_conv only). The grid9 rows are mid-training (a few hundred iterations) and report the last-200 mean (final in parentheses). No greedy-eval artifact exists for any run except paper\_jepa\_conv crossattn1}{table.caption.16}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11.4}Result B: the convolutional front-end and its sharp covert-cueing algorithm}{31}{section.11.4}\protected@file@percent }
\newlabel{sec:jepa-resultB}{{11.4}{31}{Result B: the convolutional front-end and its sharp covert-cueing algorithm}{section.11.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.1}{\ignorespaces \textbf  {The frame-repeat pixel route is recurrence-centric.} Memory-key cross-attention across the $35$ physical frames for the no-VAE frame-repeat model. The allocation is near-uniform; the only structure is a transient cue-frame read. There is no change-lock at any memory width --- detection is carried by the recurrent cell, not the attention weights.}}{32}{figure.caption.17}\protected@file@percent }
\newlabel{fig:jepa-fr}{{11.1}{32}{\textbf {The frame-repeat pixel route is recurrence-centric.} Memory-key cross-attention across the $35$ physical frames for the no-VAE frame-repeat model. The allocation is near-uniform; the only structure is a transient cue-frame read. There is no change-lock at any memory width --- detection is carried by the recurrent cell, not the attention weights}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.2}{\ignorespaces \textbf  {Psychometric cueing benefit.} P(declare change) versus change magnitude for validly and invalidly cued changes. Valid cueing left-shifts the curve (e.g.\ $0.58$ vs $0.43$ at $16^\circ $), saturating by $44^\circ $ --- the behavioural signature of covert spatial attention.}}{33}{figure.caption.18}\protected@file@percent }
\newlabel{fig:jepa-psych}{{11.2}{33}{\textbf {Psychometric cueing benefit.} P(declare change) versus change magnitude for validly and invalidly cued changes. Valid cueing left-shifts the curve (e.g.\ $0.58$ vs $0.43$ at $16^\circ $), saturating by $44^\circ $ --- the behavioural signature of covert spatial attention}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.3}{\ignorespaces \textbf  {Frame-gated attention.} Summed image-key cross-attention by frame. The network reads the image only on the cue frame ($t{=}1$) and runs from memory thereafter; the live image is preserved on the residual.}}{33}{figure.caption.19}\protected@file@percent }
\newlabel{fig:jepa-framegate}{{11.3}{33}{\textbf {Frame-gated attention.} Summed image-key cross-attention by frame. The network reads the image only on the cue frame ($t{=}1$) and runs from memory thereafter; the live image is preserved on the residual}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11.5}Informative negatives: what fences the recipe}{33}{section.11.5}\protected@file@percent }
\newlabel{sec:jepa-negatives}{{11.5}{33}{Informative negatives: what fences the recipe}{section.11.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.4}{\ignorespaces \textbf  {Cue-timed memory change-lock.} Memory-key attention maps across frames. Validly cued changes lock onto the changed location one frame earlier ($t{=}5$) than invalid ($t{=}6$) --- the attentional analogue of the behavioural cueing benefit.}}{34}{figure.caption.20}\protected@file@percent }
\newlabel{fig:jepa-lock}{{11.4}{34}{\textbf {Cue-timed memory change-lock.} Memory-key attention maps across frames. Validly cued changes lock onto the changed location one frame earlier ($t{=}5$) than invalid ($t{=}6$) --- the attentional analogue of the behavioural cueing benefit}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11.6}Set-size-9 generalization (in progress)}{34}{section.11.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11.5}{\ignorespaces \textbf  {Temporal decoding of the recurrent state.} Cross-validated balanced accuracy of a logistic probe on $\text  {vec}(H)$. Cue position/value are decodable from $t{=}1$; change presence/location become decodable at $t{=}5$, one frame before the invalid-condition attention lock --- recurrence computes, attention reflects.}}{35}{figure.caption.21}\protected@file@percent }
\newlabel{fig:jepa-decode}{{11.5}{35}{\textbf {Temporal decoding of the recurrent state.} Cross-validated balanced accuracy of a logistic probe on $\text {vec}(H)$. Cue position/value are decodable from $t{=}1$; change presence/location become decodable at $t{=}5$, one frame before the invalid-condition attention lock --- recurrence computes, attention reflects}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.6}{\ignorespaces \textbf  {Causal perturbation of the memory read.} Additively suppressing memory tokens on validly cued trials lowers detection modestly but does not abolish it: the changed Gabor enters on the residual, so the memory read refines rather than carries the change signal.}}{35}{figure.caption.22}\protected@file@percent }
\newlabel{fig:jepa-causal}{{11.6}{35}{\textbf {Causal perturbation of the memory read.} Additively suppressing memory tokens on validly cued trials lowers detection modestly but does not abolish it: the changed Gabor enters on the residual, so the memory read refines rather than carries the change signal}{figure.caption.22}{}}
