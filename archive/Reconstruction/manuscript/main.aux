\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Signed contour map of $\Delta \mathrm  {VDA}:= \mathrm  {VDA}(\rho {=}0.2) - \mathrm  {VDA}(\rho {=}0)$ over $(V, v)$ for each $r\in \{0.3,\,1,\,3\}$. Red: $\rho $ amplifies $\mathrm  {VDA}$; blue: $\rho $ suppresses; white: $|\Delta \mathrm  {VDA}| < 10^{-8}$. At $r= 0.3$ (cost-dominant) suppression dominates at low $V$; at $r\in \{1, 3\}$ amplification dominates across the bulk of the plane, with the strongest amplification near $(V, v) \approx (0.5, 10)$.}}{16}{figure.8}\protected@file@percent }
\newlabel{fig:iso-vda-drho}{{8}{16}{Signed contour map of $\Delta \VDA := \VDA (\corr {=}0.2) - \VDA (\corr {=}0)$ over $(\valid , \val )$ for each $\Rsens \in \{0.3,\,1,\,3\}$. Red: $\corr $ amplifies $\VDA $; blue: $\corr $ suppresses; white: $|\Delta \VDA | < 10^{-8}$. At $\Rsens = 0.3$ (cost-dominant) suppression dominates at low $\valid $; at $\Rsens \in \{1, 3\}$ amplification dominates across the bulk of the plane, with the strongest amplification near $(\valid , \val ) \approx (0.5, 10)$}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Cell-wise sign of $\partial \mathrm  {VDA}/ \partial \rho $ across the $(V, v)$ plane at each $r$ stratum. Fractions are over the $589$ cells per panel; the residual share is the zero-class $|\Delta \mathrm  {VDA}| < 10^{-8}$. Cost-dominant $r= 0.3$ cells are suppression-dominated; the symmetric and benefit-dominant strata are amplification-dominated.}}{16}{table.8}\protected@file@percent }
\newlabel{tab:graded-signflip}{{8}{16}{Cell-wise sign of $\partial \VDA / \partial \corr $ across the $(\valid , \val )$ plane at each $\Rsens $ stratum. Fractions are over the $589$ cells per panel; the residual share is the zero-class $|\Delta \VDA | < 10^{-8}$. Cost-dominant $\Rsens = 0.3$ cells are suppression-dominated; the symmetric and benefit-dominant strata are amplification-dominated}{table.8}{}}
