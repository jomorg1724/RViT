\contentsline {chapter}{\numberline {16}Summary of findings}{46}{chapter.16}%
\contentsline {section}{\numberline {16.1}Established findings}{46}{section.16.1}%
\contentsline {paragraph}{F1. Perception is the bottleneck on the short task.}{46}{section*.33}%
\contentsline {paragraph}{F2. One VAE serves all task variants.}{46}{section*.34}%
\contentsline {paragraph}{F3. The horizon decides the strategy.}{46}{section*.35}%
\contentsline {paragraph}{F4. Coupling is a precondition for learning.}{46}{section*.36}%
\contentsline {paragraph}{F5. Routing decides the phenotype, not representation.}{46}{section*.37}%
\contentsline {paragraph}{F6. A grounded image pathway is required.}{46}{section*.38}%
\contentsline {paragraph}{F7. The working model reproduces the paper's behaviour.}{47}{section*.39}%
\contentsline {paragraph}{F8. The cueing effect is memory-driven, across the whole family.}{47}{section*.40}%
\contentsline {paragraph}{F9. The harness is a stable recipe with two failure harbors.}{47}{section*.41}%
\contentsline {paragraph}{F10. Two stacked memories is the best detector, and the recommended network.}{47}{section*.42}%
\contentsline {paragraph}{F11. Perception is learnable without a pretrained VAE.}{47}{section*.43}%
